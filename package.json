{
  "name": "scheduler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:unit": "jest --testPathPatterns=src/.*\\.test\\.(ts|tsx)$",
    "test:integration": "jest --testPathPatterns=src/.*\\.integration\\.(ts|tsx)$",
    "test:e2e": "playwright test",
    "test:transportation-segments": "jest --config jest.transportation-segments.config.js",
    "test:transportation-segments:performance": "jest --config jest.transportation-segments.config.js --testNamePattern=performance",
    "validate:transportation-segments": "node scripts/validate-transportation-segments-setup.js",
    "daemon:cleanup": "node src/scripts/start-appointment-cleanup-daemon.js",
    "calendar-sync": "node src/scripts/calendar-sync-worker.js",
    "calendar-sync-daemon": "node src/scripts/calendar-sync-daemon.js",
    "enhanced-calendar-sync-daemon": "node src/scripts/enhanced-calendar-sync-daemon.js",
    "unified-calendar-sync-daemon": "node src/scripts/unified-calendar-sync-daemon.js",
    "compatible-unified-calendar-daemon": "node src/scripts/compatible-unified-calendar-daemon.js",
    "test:calendar-sync": "node test-calendar-sync.js",
    "clear-calendar-events": "node clear-all-calendar-events.js",
    "force-clear-calendar-events": "node force-clear-calendar-events.js",
    "debug-calendar-sync": "node debug-calendar-sync.js",
    "cleanup-orphaned-events": "node cleanup-orphaned-calendar-events.js",
    "force-cleanup-all-events": "node force-cleanup-all-calendar-events.js",
    "test:orphaned-cleanup": "node test-orphaned-simple.js",
    "db:migrate": "node scripts/migrations.js apply",
    "db:status": "node scripts/migrations.js status",
    "db:telegram": "node scripts/migrations.js telegram",
    "db:list": "node scripts/db-manager.js list-tables",
    "db:describe": "node scripts/db-manager.js describe",
    "db:check": "node scripts/simple-migrate.js check",
    "db:test": "node scripts/simple-migrate.js test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "setup:google-maps": "node scripts/setup-google-maps.js",
    "test:e2e:install": "playwright install",
    "test:e2e:forms": "playwright test tests/e2e/forms/",
    "test:e2e:api": "playwright test tests/e2e/api/",
    "test:e2e:buttons": "playwright test tests/e2e/interactions/",
    "test:performance": "playwright test --project=performance",
    "test:performance:lighthouse": "lighthouse http://localhost:3000 --output=json --output-path=./performance-reports/lighthouse-report.json",
    "test:performance:ci": "playwright test --project=performance --reporter=json --output-dir=performance-reports",
    "test:accessibility": "playwright test --project=accessibility",
    "test:accessibility:ci": "playwright test --project=accessibility --reporter=json --output-dir=accessibility-reports",
    "test:a11y": "npm run test:accessibility",
    "test:comprehensive": "./scripts/run-comprehensive-tests.sh --all",
    "test:comprehensive:forms": "./scripts/run-comprehensive-tests.sh --forms",
    "test:comprehensive:api": "./scripts/run-comprehensive-tests.sh --api",
    "test:comprehensive:buttons": "./scripts/run-comprehensive-tests.sh --buttons",
    "validate-env": "node scripts/validate-env.js",
    "env:check": "npm run validate-env",
    "timezone:check": "node scripts/check-timezone-freshness.js",
    "timezone:validate": "npm run timezone:check && npm run lint",
    "docker:setup": "./docker/docker-setup.sh setup",
    "docker:start": "./docker/docker-setup.sh start",
    "docker:stop": "./docker/docker-setup.sh stop",
    "docker:restart": "./docker/docker-setup.sh restart",
    "docker:status": "./docker/docker-setup.sh status",
    "docker:logs": "./docker/docker-setup.sh logs",
    "docker:cleanup": "./docker/docker-setup.sh cleanup",
    "migrate:validate": "./scripts/validate-migration.sh",
    "migrate:backup": "./scripts/backup-data.sh",
    "migrate:restore": "./scripts/restore-data.sh",
    "migrate:to-cloud": "./scripts/migrate-to-cloud.sh",
    "migrate:rollback": "./scripts/rollback-migration.sh",
    "reminders:30min": "node scripts/simple-30min-reminder-worker.js",
    "reminders:simple": "node scripts/simple-reminder-worker.js",
    "reminders:test": "curl http://localhost:3000/api/test-30min-reminders"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/list": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@googlemaps/js-api-loader": "^1.16.10",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@hapi/boom": "^10.0.1",
    "@hookform/resolvers": "^5.2.1",
    "@supabase/supabase-js": "^2.56.1",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.1",
    "@types/uuid": "^10.0.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.2",
    "googleapis": "^160.0.0",
    "lucide-react": "^0.542.0",
    "next": "15.5.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "uuid": "^11.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.10.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^30.1.2",
    "jest-environment-jsdom": "^30.1.2",
    "lighthouse": "^12.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "web-vitals": "^4.2.4"
  }
}

# =============================================================================
# MediCare Scheduler - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your actual values
#
# SECURITY WARNING: Never commit .env.local to version control!
# This file contains sensitive information including API keys and secrets.
# =============================================================================

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Application environment and basic settings
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Timezone configuration (GMT+4 Dubai time)
TZ=Asia/Dubai

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Local Supabase Development Environment (Docker)
# These are the default values for local development with Supabase CLI
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# =============================================================================
# SUPABASE PRODUCTION CONFIGURATION
# =============================================================================
# For production deployment, replace the above with your actual Supabase project credentials
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# GOOGLE CALENDAR API CONFIGURATION
# =============================================================================
# Service Account Authentication (Recommended for server-side operations)
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_CALENDAR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_PROJECT_ID=your-google-cloud-project-id

# OAuth2 Client Configuration (Alternative authentication method)
GOOGLE_CALENDAR_CLIENT_ID=your_google_client_id_here
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_client_secret_here

# API Key for public API access (optional)
GOOGLE_CALENDAR_API_KEY=your_google_api_key_here

# Webhook Security
# Generate a secure random string for webhook validation
GOOGLE_CALENDAR_WEBHOOK_SECRET=your_secure_webhook_secret_here

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================
# SMTP settings for daily agenda emails and notifications
# Configure with your email provider (Gmail, SendGrid, AWS SES, etc.)
SMTP_HOST=your_smtp_host_here
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here

# Email sender configuration
SMTP_FROM_NAME=MediCare Scheduler
SMTP_FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# SECURITY & PERFORMANCE CONFIGURATION
# =============================================================================
# JWT Secret for session management (generate a secure random string)
JWT_SECRET=your_jwt_secret_here

# Rate limiting configuration
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Database connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=30000

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Logging level (error, warn, info, debug)
LOG_LEVEL=info

# Error tracking (optional - for production monitoring)
# SENTRY_DSN=your_sentry_dsn_here

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================
# Test database configuration (for running tests)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Mock external services in development
MOCK_GOOGLE_CALENDAR=false
MOCK_EMAIL_SERVICE=false

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# Port configuration (for production deployment)
PORT=3000

# Health check endpoint
HEALTH_CHECK_PATH=/api/health

# CORS configuration (for production)
CORS_ORIGIN=https://yourdomain.com

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
# 1. Copy this file to .env.local
# 2. Fill in all the required values above
# 3. For local development, the Supabase defaults will work with 'npx supabase start'
# 4. For Google Calendar integration, follow the setup guide in docs/google-calendar-setup.md
# 5. For email configuration, set up SMTP with your preferred provider
# 6. Generate secure secrets for JWT_SECRET and GOOGLE_CALENDAR_WEBHOOK_SECRET
# 7. Run 'npm run validate-env' to check your configuration
# =============================================================================

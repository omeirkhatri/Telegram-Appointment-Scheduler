-- Create transportation segment override audit table
-- This table tracks manual overrides for transportation segments with detailed conflict information

CREATE TABLE IF NOT EXISTS transportation_segment_override_audit (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  segment_id UUID NOT NULL REFERENCES transportation_segments(id) ON DELETE CASCADE,
  appointment_id UUID NOT NULL REFERENCES appointments(id) ON DELETE CASCADE,
  operation_type TEXT NOT NULL CHECK (operation_type IN ('transportation_segment_override', 'driver_reassignment_override', 'timing_override')),
  override_reason TEXT NOT NULL CHECK (override_reason IN ('driver_conflict', 'timing_conflict', 'travel_buffer_insufficient', 'manual_requirement', 'emergency_override')),
  user_id UUID NOT NULL,
  user_name TEXT,

  -- Override details
  original_driver_id UUID REFERENCES staff(id),
  new_driver_id UUID REFERENCES staff(id),
  original_planned_start TIMESTAMPTZ,
  new_planned_start TIMESTAMPTZ,
  original_planned_end TIMESTAMPTZ,
  new_planned_end TIMESTAMPTZ,

  -- Conflict details (stored as JSONB for flexibility)
  conflict_details JSONB NOT NULL DEFAULT '{}',

  -- Override justification
  override_justification TEXT NOT NULL,
  requires_follow_up BOOLEAN NOT NULL DEFAULT false,
  follow_up_reminder_sent BOOLEAN DEFAULT false,

  -- Timestamps
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),

  -- Additional metadata
  metadata JSONB DEFAULT '{}'
);

-- Create indexes for efficient querying
CREATE INDEX IF NOT EXISTS idx_transportation_segment_override_audit_segment_id
  ON transportation_segment_override_audit(segment_id);

CREATE INDEX IF NOT EXISTS idx_transportation_segment_override_audit_appointment_id
  ON transportation_segment_override_audit(appointment_id);

CREATE INDEX IF NOT EXISTS idx_transportation_segment_override_audit_user_id
  ON transportation_segment_override_audit(user_id);

CREATE INDEX IF NOT EXISTS idx_transportation_segment_override_audit_operation_type
  ON transportation_segment_override_audit(operation_type);

CREATE INDEX IF NOT EXISTS idx_transportation_segment_override_audit_requires_follow_up
  ON transportation_segment_override_audit(requires_follow_up)
  WHERE requires_follow_up = true;

CREATE INDEX IF NOT EXISTS idx_transportation_segment_override_audit_created_at
  ON transportation_segment_override_audit(created_at);

-- Create updated_at trigger
CREATE OR REPLACE FUNCTION update_transportation_segment_override_audit_updated_at()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_update_transportation_segment_override_audit_updated_at
  BEFORE UPDATE ON transportation_segment_override_audit
  FOR EACH ROW
  EXECUTE FUNCTION update_transportation_segment_override_audit_updated_at();

-- Row Level Security (RLS) policies
ALTER TABLE transportation_segment_override_audit ENABLE ROW LEVEL SECURITY;

-- Policy: Authenticated users can read all override audits
CREATE POLICY "Authenticated users can read transportation segment override audits"
  ON transportation_segment_override_audit
  FOR SELECT
  TO authenticated
  USING (true);

-- Policy: Authenticated users can insert override audits
CREATE POLICY "Authenticated users can insert transportation segment override audits"
  ON transportation_segment_override_audit
  FOR INSERT
  TO authenticated
  WITH CHECK (true);

-- Policy: Authenticated users can update override audits
CREATE POLICY "Authenticated users can update transportation segment override audits"
  ON transportation_segment_override_audit
  FOR UPDATE
  TO authenticated
  USING (true);

-- Policy: Authenticated users can delete override audits
CREATE POLICY "Authenticated users can delete transportation segment override audits"
  ON transportation_segment_override_audit
  FOR DELETE
  TO authenticated
  USING (true);

-- Add comments for documentation
COMMENT ON TABLE transportation_segment_override_audit IS 'Audit trail for transportation segment manual overrides with conflict details and follow-up tracking';
COMMENT ON COLUMN transportation_segment_override_audit.segment_id IS 'Reference to the transportation segment that was overridden';
COMMENT ON COLUMN transportation_segment_override_audit.appointment_id IS 'Reference to the appointment containing the segment';
COMMENT ON COLUMN transportation_segment_override_audit.operation_type IS 'Type of override operation performed';
COMMENT ON COLUMN transportation_segment_override_audit.override_reason IS 'Reason for the override (conflict type)';
COMMENT ON COLUMN transportation_segment_override_audit.user_id IS 'ID of the user who performed the override';
COMMENT ON COLUMN transportation_segment_override_audit.conflict_details IS 'JSONB object containing detailed conflict information';
COMMENT ON COLUMN transportation_segment_override_audit.override_justification IS 'User-provided justification for the override';
COMMENT ON COLUMN transportation_segment_override_audit.requires_follow_up IS 'Whether this override requires follow-up confirmation';
COMMENT ON COLUMN transportation_segment_override_audit.follow_up_reminder_sent IS 'Whether a follow-up reminder has been sent';

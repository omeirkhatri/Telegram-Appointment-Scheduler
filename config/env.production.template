# Production Environment Configuration Template
# Copy this file to .env and update with your actual values

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://your-server-ip:3000
TZ=Asia/Dubai

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Your Supabase project URL (internal Docker network)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Generate these keys using: openssl rand -base64 32
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# JWT Secret (MUST be changed in production - use: openssl rand -base64 32)
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Database connection string for direct access
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# Database credentials (for Supabase services)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# =============================================================================
# AUTH CONFIGURATION
# =============================================================================
# External URL for API (accessible from outside Docker)
API_EXTERNAL_URL=http://your-server-ip:54321
GOTRUE_SITE_URL=http://your-server-ip:3000
GOTRUE_URI_ALLOW_LIST=http://your-server-ip:3000,https://your-domain.com

# Email configuration
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_SMTP_ADMIN_EMAIL=admin@your-domain.com
GOTRUE_SMTP_SENDER_NAME=MediCare Scheduler

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
FILE_SIZE_LIMIT=52428800

# =============================================================================
# GOOGLE MAPS API CONFIGURATION
# =============================================================================
# Google Maps API Key for production
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Make sure to enable the following APIs:
# - Maps JavaScript API
# - Geocoding API
# - Places API (if needed for address autocomplete)
# Configure API restrictions for production security
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# =============================================================================
# GOOGLE CALENDAR SERVICE ACCOUNT CONFIGURATION
# =============================================================================
# Google Calendar Service Account for staff calendar management
# This replaces OAuth-based calendar sync with service account approach
# See docs/google-calendar-setup.md for detailed setup instructions

# Service Account Credentials (server-side only)
# Download the JSON key file from Google Cloud Console and convert to base64
# Command: cat path/to/service-account-key.json | base64 -w 0
GOOGLE_CALENDAR_SERVICE_ACCOUNT_KEY=your-base64-encoded-service-account-json-here

# Service Account Email (from the JSON key file)
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Google Calendar API Configuration
GOOGLE_CALENDAR_API_ENABLED=true
GOOGLE_CALENDAR_VERIFICATION_ENABLED=true

# Calendar naming and sharing settings
GOOGLE_CALENDAR_ORGANIZATION_NAME=BestDOC
GOOGLE_CALENDAR_DEFAULT_TIMEZONE=Asia/Dubai

# Error handling and retry configuration
GOOGLE_CALENDAR_MAX_RETRIES=3
GOOGLE_CALENDAR_RETRY_DELAY_MS=1000
GOOGLE_CALENDAR_OPERATION_TIMEOUT_MS=30000

# Email configuration for calendar invites
GOOGLE_CALENDAR_EMAIL_FROM=noreply@bestdoc.com
GOOGLE_CALENDAR_EMAIL_FROM_NAME=BestDOC Scheduler

# =============================================================================
# TRANSPORTATION SEGMENTS CONFIGURATION
# =============================================================================
# Transportation Segments Feature Flags (for staged rollout)
# Enable these gradually for production rollout
TRANSPORTATION_SEGMENTS_ENABLED=false
TRANSPORTATION_SEGMENTS_UI_ENABLED=false
TRANSPORTATION_SEGMENTS_CALENDAR_ENABLED=false
TRANSPORTATION_SEGMENTS_NOTIFICATIONS_ENABLED=false
TRANSPORTATION_SEGMENTS_MAPS_ENABLED=false
TRANSPORTATION_SEGMENTS_DRIVER_BOARD_ENABLED=false
TRANSPORTATION_SEGMENTS_REPORTING_ENABLED=false
TRANSPORTATION_SEGMENTS_OVERRIDES_ENABLED=false
TRANSPORTATION_SEGMENTS_TRAVEL_TIME_ENABLED=false

# Transportation Segments Configuration
TRANSPORTATION_SEGMENTS_DEFAULT_BUFFER_MINUTES=20
TRANSPORTATION_SEGMENTS_MIN_TRAVEL_GAP_MINUTES=15
TRANSPORTATION_SEGMENTS_MAX_DAILY_SEGMENTS_PER_DRIVER=20
TRANSPORTATION_SEGMENTS_OVERRIDE_REMINDER_HOURS=2

# Google Maps Distance Matrix API Configuration for Transportation Segments
GOOGLE_MAPS_DISTANCE_MATRIX_ENABLED=true
GOOGLE_MAPS_DISTANCE_MATRIX_QUOTA_LIMIT=10000
GOOGLE_MAPS_DISTANCE_MATRIX_CACHE_TTL_HOURS=24
GOOGLE_MAPS_DISTANCE_MATRIX_FALLBACK_ENABLED=true

# =============================================================================
# TELEGRAM CONFIGURATION
# =============================================================================
# Telegram Bot Token (required for notifications)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-token

# =============================================================================
# MONITORING & LOGGING (Optional)
# =============================================================================
# LOG_LEVEL=info
# ENABLE_METRICS=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Disable signup in production (set to true)
GOTRUE_DISABLE_SIGNUP=false

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Default organization and project names for Supabase Studio
DEFAULT_ORGANIZATION_NAME=MediCare Organization
DEFAULT_PROJECT_NAME=MediCare Scheduler

# Public URL for Supabase Studio
SUPABASE_PUBLIC_URL=http://your-server-ip:54321

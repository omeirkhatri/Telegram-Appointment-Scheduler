# Development Environment Configuration Template
# Copy this file to .env.local for local development

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
TZ=Asia/Dubai

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Your Supabase project URL (local Docker network)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Generate these keys using: openssl rand -base64 32
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# JWT Secret (for development - use: openssl rand -base64 32)
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Database connection string for direct access
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# =============================================================================
# GOOGLE MAPS API CONFIGURATION
# =============================================================================
# Google Maps API Key for development
# Get your API key from: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# =============================================================================
# GOOGLE CALENDAR OAUTH CONFIGURATION (OPTIONAL FOR DEVELOPMENT)
# =============================================================================
# Google OAuth 2.0 credentials for Calendar integration
# These are optional for development - set to enable Google Calendar sync
# See docs/google-cloud-oauth-setup.md for detailed setup instructions

# OAuth Client Credentials (server-side only)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id-here
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret-here
GOOGLE_OAUTH_REDIRECT_URI=https://schedule.n8nbdoc.com/api/google-calendar/callback

# Encryption key for storing OAuth tokens (generate with: openssl rand -base64 32)
GOOGLE_OAUTH_ENCRYPTION_KEY=your-32-byte-encryption-key-here

# Feature flags for Google Calendar sync (set to true to enable)
GOOGLE_CALENDAR_SYNC_ENABLED=false
NEXT_PUBLIC_GOOGLE_CALENDAR_SYNC_ENABLED=false

# =============================================================================
# TELEGRAM CONFIGURATION (OPTIONAL FOR DEVELOPMENT)
# =============================================================================
# Telegram Bot Token (optional for development)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-token

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
LOG_LEVEL=debug

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Disable signup in development (set to false for testing)
GOTRUE_DISABLE_SIGNUP=false
